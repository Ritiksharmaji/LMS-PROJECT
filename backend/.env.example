# Database
DB_URL=jdbc:postgresql://localhost:5432/orbitly
DB_USERNAME=postgres
DB_PASSWORD=

# Auth — at least 32 random bytes in production
JWT_SECRET=change-me-to-a-long-random-secret-value

# Frontend
APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mail (SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# Billing: "test" (no real money) or "stripe"
BILLING_PROVIDER=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Media: "local" or "s3" (works with Cloudflare R2: set S3_ENDPOINT and S3_REGION=auto)
MEDIA_STORAGE=local
API_URL=http://localhost:8080
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# Mux video (optional; without it lessons use plain video URLs)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
